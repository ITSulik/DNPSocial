@page "/posts/{id:int}"
@inject IPostService PostService
@inject ICommentService CommentService
@inject NavigationManager NavigationManager

<PageTitle>Post</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (post is null)
{
    <p>Loading...</p>
}
else
{
    @if (isEditing)
    {
        <h1>Edit post</h1>
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input class="form-control" @bind="editTitle" />
        </div>
        <div class="mb-3">
            <label class="form-label">Body</label>
            <textarea class="form-control" rows="5" @bind="editBody"></textarea>
        </div>
        <button class="btn btn-primary" @onclick="SaveEditAsync">Save</button>
        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
    }
    else
    {
        <h1>@post.Title</h1>
        <p class="text-muted">by @(post.AuthorUsername ?? "Unknown") on @post.Created.ToString("g")</p>
        <p>@post.Body</p>

        @* Step 6.3: only the post's author sees these buttons. *@
        @if (currentUserId == post.UserId)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="StartEdit">Edit post</button>
            <button class="btn btn-outline-danger btn-sm" @onclick="DeletePostAsync">Delete post</button>
        }
    }

    @if (postError is not null)
    {
        <div class="alert alert-danger mt-2">@postError</div>
    }

    <h3 class="mt-4">Comments</h3>
    @if (comments is null)
    {
        <p>Loading comments...</p>
    }
    else if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (CommentDto comment in comments)
            {
                <li class="list-group-item">
                    <strong>@(comment.AuthorUsername ?? "Unknown")</strong>: @comment.Body
                    @if (currentUserId == comment.UserId)
                    {
                        <button class="btn btn-link btn-sm text-danger" @onclick="() => DeleteCommentAsync(comment.Id)">Delete</button>
                    }
                </li>
            }
        </ul>
    }

    @if (commentError is not null)
    {
        <div class="alert alert-danger">@commentError</div>
    }

    <AuthorizeView>
        <Authorized>
            <h4>Add a comment</h4>
            <div class="mb-3">
                <textarea class="form-control" @bind="newCommentBody"></textarea>
            </div>
            <button class="btn btn-primary" @onclick="AddCommentAsync">Add Comment</button>
        </Authorized>
        <NotAuthorized>
            <p><a href="LoginPage">Log in</a> to add a comment.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = null!;

    private PostDto? post;
    private List<CommentDto>? comments;
    private int? currentUserId;

    private string newCommentBody = "";
    private bool isEditing;
    private string editTitle = "";
    private string editBody = "";

    private string? errorMessage;
    private string? postError;
    private string? commentError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id);
            comments = await CommentService.GetCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        AuthenticationState authState = await State;
        currentUserId = authState.User.GetUserId();
    }

    private void StartEdit()
    {
        editTitle = post!.Title;
        editBody = post.Body;
        postError = null;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        postError = null;
    }

    private async Task SaveEditAsync()
    {
        postError = null;
        try
        {
            post = await PostService.UpdatePostAsync(Id, new UpdatePostDto
            {
                Title = editTitle,
                Body = editBody
            });
            isEditing = false;
        }
        catch (Exception ex)
        {
            postError = ex.Message;
        }
    }

    private async Task DeletePostAsync()
    {
        postError = null;
        try
        {
            await PostService.DeletePostAsync(Id);
            NavigationManager.NavigateTo("/posts");
        }
        catch (Exception ex)
        {
            postError = ex.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        commentError = null;

        AuthenticationState authState = await State;
        int? userId = authState.User.GetUserId();
        if (userId is null)
        {
            commentError = "You need to be logged in to comment.";
            return;
        }

        try
        {
            CreateCommentDto request = new()
            {
                Body = newCommentBody,
                UserId = userId.Value,
                PostId = Id
            };
            await CommentService.CreateCommentAsync(request);
            newCommentBody = "";
            comments = await CommentService.GetCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            commentError = ex.Message;
        }
    }

    private async Task DeleteCommentAsync(int commentId)
    {
        commentError = null;
        try
        {
            await CommentService.DeleteCommentAsync(commentId);
            comments = await CommentService.GetCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            commentError = ex.Message;
        }
    }
}